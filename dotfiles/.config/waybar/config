{
    "layer": "top",
    "position": "top",
    "margin-top": 10,
    "margin-left": 20,
    "margin-right": 20,
    "height": 40,
    "spacing": 10,
    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["clock"],
    "modules-right": ["network", "pulseaudio", "battery"],

    "clock": {
        "format": "{:%I:%M %p  |  %A %d}"
    },
    "network": {
        "format-wifi": "   {essid}",
        "format-disconnected": "⚠  Desconectado"
    },
    "pulseaudio": {
        "format": "   {volume}%"
    },
    "battery": {
        "format": "{icon}  {capacity}%",
        "format-icons": ["", "", "", "", ""]
    }
}
