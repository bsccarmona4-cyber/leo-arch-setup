# ============================================================================
#  CONFIGURACIÓN MAESTRA DE NIRI (Wayland, scrollable-tiling)
#  Adaptada de tu hyprland.conf — mismos atajos SUPER, misma estética plata.
#  Instalar en: ~/.config/niri/config.kdl
#  Docs: https://github.com/YaLTeR/niri/wiki/Configuration
# ============================================================================

input {
    keyboard {
        xkb {
            layout "latam"
        }
        repeat-delay 250
        repeat-rate 40
    }
    mouse {
        natural-scroll false
    }
    touchpad {
        tap true
        natural-scroll false
    }
}

# --- LAYOUT: mismos gaps y bordes plata que Hyprland ---
layout {
    gaps 10

    border {
        on focused {
            width 2
            color "#a6a6a6"
        }
        on unfocused {
            width 2
            color "#1a1a1a"
        }
    }

    focus-ring {
        enabled true
        width 2
        active-color "#a6a6a6"
        inactive-color "#4d4d4d"
        gradient-from "#a6a6a6"
        gradient-to "#4d4d4d"
        gradient-angle 45
    }

    # Centrar la columna enfocada (look premium)
    center-focused-column "always"

    preset-column-widths {
        "1/2": 0.5
        "1/3": 0.3333333
        "2/3": 0.6666667
    }

    default-column-width "1/2"
}

# --- ARRANQUE AUTOMÁTICO (los mismos servicios de Hyprland) ---
spawn-at-startup "waybar"
spawn-at-startup "swaync"
spawn-at-startup "swaybg" "-i" "~/.config/niri/montana.jpg" "-m" "fill"
spawn-at-startup "wl-paste" "--type" "text" "--watch" "cliphist" "store"
spawn-at-startup "wl-paste" "--type" "image" "--watch" "cliphist" "store"
spawn-at-startup "/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1"
spawn-at-startup "swayosd-server"
spawn-at-startup "blueman-applet"

# --- ATAJOS DE TECLADO (idénticos a Hyprland) ---
binds {
    # Lanzamiento de aplicaciones
    Mod+Q { spawn "kitty"; }
    Mod+E { spawn "thunar"; }
    Mod+B { spawn "firefox"; }
    Mod+Space { spawn "rofi" "-show" "drun" "-show-icons"; }
    Mod+X { spawn "wlogout"; }

    # Gestión de ventanas
    Mod+C { close-window; }
    Mod+M { quit; }
    Mod+V { toggle-window-floating; }
    Mod+F { maximize-column; }

    # Historial del portapapeles (Cliphist)
    Mod+H { spawn "sh" "-c" "cliphist list | rofi -dmenu | cliphist decode | wl-copy"; }

    # Navegación y foco
    Mod+Left { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up { focus-window-up; }
    Mod+Down { focus-window-down; }

    # Escritorios virtuales (workspaces)
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }

    # Mover ventanas a otro escritorio
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }

    # Capturas de pantalla (grim + slurp + swappy / wl-copy)
    Mod+S { spawn "sh" "-c" "grim -g \"$(slurp)\" - | swappy -f -"; }
    Mod+Shift+S { spawn "sh" "-c" "grim -g \"$(slurp)\" - | wl-copy"; }

    # --- Controles físicos (ThinkPad T430) ---
    XF86AudioRaiseVolume { spawn "sh" "-c" "swayosd-client --output-volume raise"; }
    XF86AudioLowerVolume { spawn "sh" "-c" "swayosd-client --output-volume lower"; }
    XF86AudioMute { spawn "sh" "-c" "swayosd-client --output-volume mute-toggle"; }
    XF86AudioMicMute { spawn "sh" "-c" "swayosd-client --input-volume mute-toggle"; }
    XF86MonBrightnessUp { spawn "sh" "-c" "swayosd-client --brightness raise"; }
    XF86MonBrightnessDown { spawn "sh" "-c" "swayosd-client --brightness lower"; }
    XF86AudioPlay { spawn "playerctl" "play-pause"; }
    XF86AudioNext { spawn "playerctl" "next"; }
    XF86AudioPrev { spawn "playerctl" "previous"; }
    XF86Launch1 { spawn "kitty"; }
}
