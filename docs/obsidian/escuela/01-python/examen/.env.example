# Cafetería POS — Variables de entorno
# Copia este archivo como .env y llena los valores

# Motor de base de datos: "sqlite" | "postgres" | "auto"
# "auto" usa SQLite si cafeteria.db existe, si no intenta PostgreSQL
DB_TYPE=auto

# PostgreSQL local
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=tu_usuario
POSTGRES_PASSWORD=
POSTGRES_DB=cafeteria_pos

# Supabase (PostgreSQL cloud)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJh...
SUPABASE_ANON_KEY=eyJh...

# Redis cache (opcional)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USER=
REDIS_PASSWORD=

# DeepSeek API (opcional — habilita el asistente con IA)
DEEPSEEK_API_KEY=sk-...

# GitHub (para sync automático)
GITHUB_TOKEN=ghp_...
